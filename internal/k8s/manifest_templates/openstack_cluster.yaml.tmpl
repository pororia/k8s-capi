apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: OpenStackCluster
metadata:
  name: {{ .ClusterName }}
  namespace: {{ .Namespace }}
spec:
  identityRef:
    cloudName: {{ .CloudName }}
    name: {{ .ClusterName }}-cloud-config
  apiServerLoadBalancer:
    enabled: true
  externalNetwork:
    id: {{ .ExternalNetworkID }}
  network:
    id: {{ .NetworkID }}
  subnets:
    - id: {{ .SubnetID }}
  dnsNameservers:
    {{- range .DNSNameservers }}
    - {{ . }}
    {{- end }}
